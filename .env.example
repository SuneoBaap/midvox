# ═══════════════════════════════════════════════════════
# MidVox — Root Environment Variables
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# For Render, set these in Dashboard > Environment Variables.
# ═══════════════════════════════════════════════════════

# ── Bot (Python) ──────────────────────────────────────
TOKEN=your_discord_bot_token
OWNER_IDS=your_discord_user_id

# Optional: copy custom application emojis on startup (may require CDN access).
EMOJI_SYNC=false

# Dashboard API
API_ENABLED=true
API_PORT=5001
DASHBOARD_API_KEY=change_this_to_a_strong_secret
WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id

# YouTube Shorts use the local Cobalt sidecar automatically. No API key.
# Optional public URL used by Cobalt when generating tunnel links.
COBALT_PUBLIC_URL=

# Cloudflare Tunnel (optional, set to false on Render)
TUNNEL_ENABLED=false
CF_TUNNEL_TOKEN=
CF_TUNNEL_URL=

# MongoDB (optional — persist configs across deploys)
MONGO_URI=mongodb+srv://user:pass@cluster0.example.mongodb.net/midvox?retryWrites=true&w=majority

# ── Dashboard (Next.js) ───────────────────────────────
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_DASHBOARD_API_KEY=change_this_to_a_strong_secret

NEXTAUTH_URL=https://midvox.onrender.com
NEXTAUTH_SECRET=generate_a_random_string_here

DISCORD_CLIENT_ID=your_discord_oauth_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret

NEXT_PUBLIC_ADMIN_IDS=your_discord_user_id
NEXT_PUBLIC_BRAND_NAME=MidVox
NEXT_PUBLIC_BRAND_NAME_WORD=MV
