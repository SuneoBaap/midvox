# ═══════════════════════════════════════════════════════
# MidVox — Root Environment Variables
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# For Render, set these in Dashboard > Environment Variables.
# ═══════════════════════════════════════════════════════

# ── Bot (Python) ──────────────────────────────────────
TOKEN=your_discord_bot_token
OWNER_IDS=your_discord_user_id

# ── User presence (optional) ──────────────────────────────────────
# Starts Discord's official Linux desktop client on a virtual X display.
# Connect Spotify (or another supported app) in Discord's User Settings >
# Connections and enable displaying the current activity as status.
# This is a user-account login, separate from TOKEN. Keep it secret and never
# commit a real value. USER_TOKEN automation can violate Discord's terms.
USER_TOKEN=
# Optional DISBOARD /bump support; presence/activity still work when omitted.
BUMP_CHANNEL_ID=
BUMP_INTERVAL=600
# Override only when using a custom Docker image. The repository image uses
# /opt/Discord/discord.
DISCORD_DESKTOP_BIN=

# Dashboard API
API_ENABLED=true
API_PORT=5001
DASHBOARD_API_KEY=change_this_to_a_strong_secret
WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id

# YouTube Shorts use the local Cobalt sidecar automatically. No API key.
# Railway/datacenter IPs may require an authenticated YouTube session.
# Store only the Cookie request-header value here; never commit a real value.
YOUTUBE_COOKIE=
# Optional public URL used by Cobalt when generating tunnel links.
COBALT_PUBLIC_URL=

# Cloudflare Tunnel (optional, set to false on Render)
TUNNEL_ENABLED=false
CF_TUNNEL_TOKEN=
CF_TUNNEL_URL=

# MongoDB (optional — persist configs across deploys)
# Required for persistent per-guild settings across Railway redeploys.
# Reuse the same URI when moving the bot to another hosting account.
MONGO_URI=mongodb+srv://user:pass@cluster0.example.mongodb.net/midvox?retryWrites=true&w=majority

# ── Dashboard (Next.js) ───────────────────────────────
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_DASHBOARD_API_KEY=change_this_to_a_strong_secret

# Optional outside Railway. On Railway this is set automatically from
# RAILWAY_PUBLIC_DOMAIN at container startup.
NEXTAUTH_URL=http://localhost:8080
NEXTAUTH_SECRET=generate_a_random_string_here

DISCORD_CLIENT_ID=your_discord_oauth_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret

NEXT_PUBLIC_ADMIN_IDS=your_discord_user_id
NEXT_PUBLIC_BRAND_NAME=MidVox
NEXT_PUBLIC_BRAND_NAME_WORD=MV
