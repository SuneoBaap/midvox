/myenv
dashboard/node_modules
dashboard/.next


# Ignore Python cache
__pycache__/
*.py[cod]
*$py.class

# Ignore virtual environments
venv/
.venv/
env/
ENV/

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore logs
*.log

# Ignore build outputs
dist/
build/
*.tsbuildinfo

# Ignore temporary files
*.tmp
*.temp
*.db-journal
*.db-shm
*.db-wal

# Ignore Python packaging
*.egg-info/
.Python

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore environment variables
.env
.env.local
.env.*.local

# Ignore runtime-generated Cloudflare WARP files (start.sh)
.warp/

# Ignore binaries downloaded on demand by the optional tunnel helper
/bot/bin/

# Ignore obsolete source backups and archives
*_backup.*
*_original.py
/bot/cogs/**/*.tar

# Ignore images produced while commands run
/bot/data/[0-9]*.png
/bot/data/pictures/album_image.png
/bot/data/pictures/spotify_card_output.png
/bot/data/ship/tmp_ship.png

# Ignore node_modules
node_modules/
package-lock.json

# Ignore Next.js build output
.next/
out/

# Ignore Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.zip
*.rar


